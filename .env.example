# Copy to .env.local for local development. Nothing here is required locally —
# these are the defaults the app already uses.

# Where the SQLite database and uploaded files are written.
# Local default: ./data   On Render: /var/data (the mounted disk)
DATA_DIR=./data

# The first administrator account, created once when the database is empty.
# Change the password after the first sign-in.
ADMIN_EMAIL=admin@coralux.aw
ADMIN_PASSWORD=coralux2026
